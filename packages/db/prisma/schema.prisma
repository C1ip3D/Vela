generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

enum CourseType {
  STANDARD
  ADVANCED
  HONORS
  AP
  DUAL_ENROLLMENT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdvisorLogType {
  GRADE_ALERT
  ASSIGNMENT_GRADED
}

enum DataSource {
  INFINITE_CAMPUS
}

model User {
  id             String    @id @default(cuid())
  canvasUserId   String    @unique
  email          String    @unique
  displayName    String
  avatarUrl      String?
  role           UserRole  @default(STUDENT)
  canvasToken    String?
  canvasRefresh  String?
  tokenExpiresAt DateTime?
  telegramChatId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enrollments      Enrollment[]
  gradeHistory     GradeHistory[]
  gpaSnapshots     GpaSnapshot[]
  advisorLogs      AdvisorLog[]
  assignmentGrades AssignmentGrade[]
}

model Course {
  id             String     @id @default(cuid())
  canvasCourseId String     @unique
  name           String
  courseCode     String
  term           String
  courseType     CourseType @default(STANDARD)
  creditHours    Float      @default(1.0)
  apBoost        Float      @default(0.0)
  isActive       Boolean    @default(true)
  source         DataSource @default(INFINITE_CAMPUS)
  externalId     String?
  teacher        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  enrollments      Enrollment[]
  assignmentGrades AssignmentGrade[]
}

model Enrollment {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  canvasEnrollId String   @unique
  currentGrade   Float?
  letterGrade    String?
  enrolledAt     DateTime
  isActive       Boolean  @default(true)
  finalWeight    Float?   // user-set final exam weight (0–1); null = use DUSD 15% default

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
}

model GradeHistory {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  recordedAt      DateTime @default(now())
  percentageGrade Float
  gpaPoints       Float
  letterGrade     String
  missingCount    Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
}

model GpaSnapshot {
  id            String   @id @default(cuid())
  userId        String
  cumulativeGpa Float
  termGpa       Float
  weightedGpa   Float
  unweightedGpa Float
  recordedAt    DateTime @default(now())
  term          String

  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
}

model AdvisorLog {
  id          String         @id @default(cuid())
  userId      String
  logType     AdvisorLogType
  severity    AlertSeverity  @default(INFO)
  title       String
  body        Json
  triggerData Json
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AssignmentGrade {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  assignmentKey String
  name          String
  score         Float?
  maxScore      Float?
  dueDate       String?
  gradedAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId, assignmentKey])
  @@index([userId, courseId])
}
