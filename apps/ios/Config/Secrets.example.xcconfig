// Copy to Config/Secrets.xcconfig and fill in. Values mirror the EXPO_PUBLIC_* ones in the old mobile app.
// Without the FIREBASE_* values the app still works against Infinite Campus; it just skips Vela sign-in and sync.
VELA_API_BASE_URL = https:/$()/your-backend.example.com
FIREBASE_API_KEY = <EXPO_PUBLIC_FIREBASE_API_KEY>
FIREBASE_APP_ID = <EXPO_PUBLIC_FIREBASE_APP_ID>
FIREBASE_PROJECT_ID = <EXPO_PUBLIC_FIREBASE_PROJECT_ID>
FIREBASE_GCM_SENDER_ID = <EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID>
