{
  "name": "vela-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-next-for-eslint.js",
    "dev": "npm run dev -w @vela/web",
    "build": "npm run build -w @vela/web",
    "start": "npm run start -w @vela/web",
    "lint": "npm run lint -w @vela/web",
    "mobile": "npm run start -w @vela/mobile",
    "db:generate": "npm run generate -w @vela/db",
    "db:migrate": "npm run migrate -w @vela/db",
    "db:studio": "npm run studio -w @vela/db"
  }
}
